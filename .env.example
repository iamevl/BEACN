# REQUIRED: monitored network
#
# Set this to the IPv4 CIDR that BEACN is authorised to discover and probe.
# BEACN will not start while this is blank or invalid. Confirm the scope
# carefully before starting the application.
NETWORK_SUBNET=

# BEACN optional SNMP configuration
#
# A future installer can prompt for these values and write
# them into .env. Never commit real credentials.

BEACN_SNMP_ENABLED=false
BEACN_SNMP_VERSION=3

# SNMPv3 SHA + AES
BEACN_SNMP_USERNAME=
BEACN_SNMP_AUTH_PASSWORD=
BEACN_SNMP_PRIV_PASSWORD=

# SNMPv2c compatibility only
BEACN_SNMP_COMMUNITY=

# Cached SNMP device enrichment
BEACN_SNMP_CACHE_TTL_SECONDS=300

# Keep true for the production HTTPS deployment. Set false only
# when intentionally accessing a local development instance over HTTP.
BEACN_SESSION_COOKIE_SECURE=true
