<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>BEACN</title>
  <style>
    :root {
      color-scheme: dark;
      --bg: #0b1020;
      --panel: #121a2d;
      --panel2: #182238;
      --text: #e8eefc;
      --muted: #95a4c4;
      --accent: #6ee7b7;
      --danger: #fb7185;
      --border: #26334f;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif;
      background: radial-gradient(circle at top, #15213a 0, var(--bg) 42%);
      color: var(--text);
    }
    main { max-width: 1120px; margin: 0 auto; padding: 28px 18px 48px; }
    h1 { margin: 0 0 6px; font-size: 28px; }
    h2 { margin: 0 0 14px; font-size: 18px; }
    p { color: var(--muted); }
    .grid { display: grid; gap: 16px; }
    .metrics { grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); margin: 20px 0; }
    .two { grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); }
    .card {
      background: rgba(18, 26, 45, .94);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 18px;
    }
    .metric strong { display: block; font-size: 26px; margin-top: 6px; }
    label { display: block; margin-bottom: 8px; color: var(--muted); font-size: 14px; }
    select, button {
      width: 100%;
      border-radius: 11px;
      border: 1px solid var(--border);
      background: var(--panel2);
      color: var(--text);
      padding: 11px 12px;
      font-size: 15px;
    }
    button { cursor: pointer; font-weight: 650; }
    button:hover { border-color: var(--accent); }
    button.primary { background: var(--accent); color: #062419; border: 0; }
    button:disabled { opacity: .45; cursor: not-allowed; }
    .buttons { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-top: 14px; }
    .status { min-height: 24px; color: var(--muted); margin-top: 12px; }
    pre {
      white-space: pre-wrap;
      word-break: break-word;
      max-height: 360px;
      overflow: auto;
      background: #080d19;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 14px;
      color: #d9e3f7;
      min-height: 170px;
    }
    table { width: 100%; border-collapse: collapse; }
    th, td { text-align: left; padding: 10px 8px; border-bottom: 1px solid var(--border); font-size: 14px; }
    th { color: var(--muted); }
    .badge {
      display: inline-flex;
      padding: 3px 8px;
      border-radius: 999px;
      background: #20304a;
      font-size: 12px;
    }
    .good { color: var(--accent); }
    .bad { color: var(--danger); }
    .toolbar { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
    .toolbar button { width: auto; }
    small { color: var(--muted); }
    @media (max-width: 600px) {
      .buttons { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
<main>
  <h1>BEACN</h1>
  <p>Discovery, diagnostics and iperf3 testing for {{ subnet }}.</p>

  <section class="grid metrics">
    <div class="card metric"><small>Online devices</small><strong id="onlineCount">0</strong></div>
    <div class="card metric"><small>New since first scan</small><strong id="newCount">0</strong></div>
    <div class="card metric"><small>iperf3 servers</small><strong id="iperfCount">0</strong></div>
    <div class="card metric"><small>Last refresh</small><strong id="lastRefresh">Never</strong></div>
  </section>

  <section class="grid two">
    <div class="card">
      <h2>Device tools</h2>
      <label for="deviceSelect">Discovered device</label>
      <select id="deviceSelect"></select>
      <div class="buttons">
        <button id="scanBtn" class="primary" type="button">Rescan network</button>
        <button id="pingBtn" type="button">Ping</button>
        <button id="portsBtn" type="button">Scan top 100 ports</button>
        <button id="iperfBtn" type="button">Run iperf3</button>
        <button id="iperfReverseBtn" type="button">Run reverse iperf3</button>
        <button id="resultsBtn" type="button">Show saved results</button>
      </div>
      <div id="status" class="status" aria-live="polite"></div>
    </div>

    <div class="card">
      <h2>Selected device</h2>
      <table>
        <tbody>
          <tr><th>IP</th><td id="dIp">—</td></tr>
          <tr><th>Hostname</th><td id="dHostname">—</td></tr>
          <tr><th>MAC</th><td id="dMac">—</td></tr>
          <tr><th>Vendor</th><td id="dVendor">—</td></tr>
          <tr><th>Status</th><td id="dOnline">—</td></tr>
          <tr><th>iperf3</th><td id="dIperf">—</td></tr>
          <tr><th>Last seen</th><td id="dLastSeen">—</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="card" style="margin-top:16px">
    <div class="toolbar">
      <h2 style="margin:0">Output</h2>
      <span class="badge">iperf3 port {{ iperf_port }}</span>
    </div>
    <pre id="output">Ready.</pre>
  </section>
</main>

<script>
  let devices = [];
  const select = document.getElementById('deviceSelect');
  const output = document.getElementById('output');
  const status = document.getElementById('status');

  function selectedDevice() {
    return devices.find(d => d.ip === select.value);
  }

  function formatRate(bps) {
    if (!bps) return 'n/a';
    return `${(bps / 1e6).toFixed(1)} Mbps`;
  }

  function renderSelected() {
    const d = selectedDevice();
    document.getElementById('dIp').textContent = d?.ip || '—';
    document.getElementById('dHostname').textContent = d?.hostname || '—';
    document.getElementById('dMac').textContent = d?.mac || '—';
    document.getElementById('dVendor').textContent = d?.vendor || '—';
    document.getElementById('dOnline').innerHTML = d ? (d.is_online ? '<span class="good">Online</span>' : '<span class="bad">Offline</span>') : '—';
    document.getElementById('dIperf').innerHTML = d ? (d.iperf_available ? '<span class="good">Available</span>' : '<span class="bad">Not detected</span>') : '—';
    document.getElementById('dLastSeen').textContent = d?.last_seen || '—';
    document.getElementById('iperfBtn').disabled = !d?.iperf_available;
    document.getElementById('iperfReverseBtn').disabled = !d?.iperf_available;
  }

  async function refreshDevices() {
    const response = await fetch('/api/devices');
    const payload = await response.json();
    const old = select.value;
    devices = payload.devices;
    select.innerHTML = devices.map(d => {
      const name = d.hostname ? `${d.hostname} · ` : '';
      const suffix = d.iperf_available ? ' · iperf3' : '';
      return `<option value="${d.ip}">${name}${d.ip}${suffix}</option>`;
    }).join('');
    if (devices.some(d => d.ip === old)) select.value = old;

    document.getElementById('onlineCount').textContent = devices.filter(d => d.is_online).length;
    document.getElementById('newCount').textContent = devices.filter(d => d.first_seen === d.last_seen).length;
    document.getElementById('iperfCount').textContent = devices.filter(d => d.iperf_available).length;
    document.getElementById('lastRefresh').textContent = new Date().toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'});
    status.textContent = payload.scan.running ? 'Network scan running…' : (payload.scan.last_error || '');
    renderSelected();
  }

  async function post(url, body) {
    status.textContent = 'Working…';
    output.textContent = 'Running command…';
    try {
      const response = await fetch(url, {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify(body || {})
      });
      const payload = await response.json();
      if (!response.ok) throw new Error(payload.error || 'Request failed');
      status.textContent = payload.message || (payload.ok ? 'Complete.' : 'Command returned an error.');
      return payload;
    } catch (error) {
      status.textContent = error.message;
      output.textContent = error.message;
      throw error;
    }
  }

  document.getElementById('scanBtn').addEventListener('click', async () => {
    await post('/api/scan', {});
    output.textContent = 'Discovery scan started. Refreshing device list…';
    setTimeout(refreshDevices, 2500);
    setTimeout(refreshDevices, 7000);
  });

  document.getElementById('pingBtn').addEventListener('click', async () => {
    const d = selectedDevice(); if (!d) return;
    const r = await post('/api/ping', {target: d.ip});
    output.textContent = r.stdout || r.stderr || 'No output.';
  });

  document.getElementById('portsBtn').addEventListener('click', async () => {
    const d = selectedDevice(); if (!d) return;
    const r = await post('/api/ports', {target: d.ip});
    output.textContent = r.stdout || r.stderr || 'No output.';
  });

  async function runIperf(reverse) {
    const d = selectedDevice(); if (!d) return;
    const r = await post('/api/iperf', {target: d.ip, reverse});
    output.textContent =
      `Direction: ${r.direction}\nThroughput: ${formatRate(r.bits_per_second)}\nRetransmits: ${r.retransmits ?? 'n/a'}\n\n${r.stdout || r.stderr || ''}`;
    refreshDevices();
  }

  document.getElementById('iperfBtn').addEventListener('click', () => runIperf(false));
  document.getElementById('iperfReverseBtn').addEventListener('click', () => runIperf(true));

  document.getElementById('resultsBtn').addEventListener('click', async () => {
    const d = selectedDevice();
    const response = await fetch(`/api/results?target=${encodeURIComponent(d?.ip || '')}`);
    const payload = await response.json();
    output.textContent = payload.results.length
      ? payload.results.map(r => `${r.created_at} | ${r.target_ip} | ${r.direction} | ${formatRate(r.bits_per_second)} | retransmits ${r.retransmits ?? 'n/a'}`).join('\n')
      : 'No saved iperf3 results for this device.';
    status.textContent = 'Saved results loaded.';
  });

  select.addEventListener('change', renderSelected);
  refreshDevices();
  setInterval(refreshDevices, 15000);
</script>
</body>
</html>
